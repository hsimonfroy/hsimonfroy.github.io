@article{simon2025benchmarkingfieldlevelcosmologicalinference,
    doi = {10.1088/1475-7516/2025/12/039},
    url = {https://doi.org/10.1088/1475-7516/2025/12/039},
    year = {2025},
    month = {dec},
    publisher = {IOP Publishing},
    volume = {2025},
    number = {12},
    pages = {039},
    author = {\me and Lanusse, François and de Mattia, Arnaud},
    title = {Benchmarking field-level cosmological inference from galaxy redshift surveys},
    journal = {Journal of Cosmology and Astroparticle Physics},
    abstract = {Field-level inference has emerged as a promising framework to fully harness the cosmological information encoded in next-generation galaxy surveys. It involves performing Bayesian inference to jointly estimate the cosmological parameters and the initial conditions of the cosmic field, directly from the observed galaxy density field. Yet, the scalability and efficiency of sampling algorithms for field-level inference of large-scale surveys remain unclear. To address this, we introduce a standardized benchmark using a fast and differentiable simulator for the galaxy density field based on JaxPM. We evaluate a range of sampling methods, including standard Hamiltonian Monte Carlo (HMC), No-U-Turn Sampler (NUTS) without and within a Gibbs scheme, and both adjusted and unadjusted microcanonical samplers (MAMS and MCLMC). These methods are compared based on their efficiency, in particular the number of model evaluations required per effective posterior sample. Our findings emphasize the importance of carefully preconditioning latent variables and demonstrate the significant advantage of (unadjusted) MCLMC for scaling to ≥ 106-dimensional problems. We find that MCLMC outperforms adjusted samplers by over an order-of-magnitude, with a mild scaling with the dimension of our inference problem. This benchmark, along with the associated publicly available code, is intended to serve as a basis for the evaluation of future field-level sampling strategies. The code is openly available at https://github.com/hsimonfroy/benchmark-field-level.},
    annote = {A systematic comparison of multiple sampling methods and strategies to perform field-level cosmological inference from galaxy redshift surveys, involving the implementation of a fast and differentiable field-level model.},
    selected = {true},
    abbr = {JCAP},
    preview = {flbench.gif}
}


